# 生产环境配置示例
# SOU-38: 在服务器上复制此文件为 .env 并填写实际值
# 位置: /opt/vocabmaster/.env

# JWT 密钥 - 必须设置为一个强随机字符串
# 生成方法: openssl rand -hex 32
SECRET_KEY=your-production-secret-key-change-this

# 数据库 URL（已在 docker-compose.prod.yml 中设置）
# DATABASE_URL=sqlite:///./data/vocabmaster.db

# 发音服务（SOU-42）
# 默认启用无密钥的有道词典公共发音源，生产开箱即用，无需申请任何 TTS 密钥。
# 如需关闭公共源（例如仅用商用密钥），设为 false：
# PRONUNCIATION_PUBLIC_ENABLED=true
# 公共发音源主机（不硬编码，通过配置注入 - SOU-35）：
# PRONUNCIATION_PUBLIC_BASE_URL=https://dict.youdao.com/dictvoice
