# 本地环境变量模板
# 复制此文件为 .env.local 并填入实际值

# 数据库连接（默认 SQLite）
DATABASE_URL=sqlite:///./vocabmaster.db

# JWT 配置
SECRET_KEY=change-this-secret-key-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 应用配置
APP_NAME=VocabMaster API
DEBUG=true

# CORS 允许的源（生产环境需要替换）
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.com

# 发音 API 配置（可选 - REQ-WORD-003）
# 有道词典 API（推荐）
# YOUDAO_APP_KEY=your-app-key
# YOUDAO_APP_SECRET=your-app-secret

# 百度翻译 API（备用）
# BAIDU_APP_ID=your-app-id
# BAIDU_SECRET_KEY=your-secret-key
